# Cloudflare에 연결한 뒤 실제 pages.dev 주소 또는 맞춤 도메인으로 바꿔 주세요.
NEXT_PUBLIC_SITE_URL=https://yuubmingulab.com
# 선택적 이용통계는 아래 측정 ID와 개인정보 요청용 이메일이 모두 유효할 때만
# 동의 창을 표시하며, 방문자가 동의하기 전에는 Google 스크립트를 불러오지 않습니다.
NEXT_PUBLIC_GOOGLE_ANALYTICS_MEASUREMENT_ID=
# AdSense 승인 뒤 게시자 ID를 넣더라도 인증 CMP와 광고 코드를 별도로 연결하기 전에는
# 이 저장소의 기본 상태에서 광고를 불러오지 않습니다.
NEXT_PUBLIC_GOOGLE_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# 네이버 서치어드바이저의 HTML 태그에서 content 값만 입력하세요.
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
# 공개 GitHub Issues가 아닌 비공개 개인정보 권리 요청을 받을 전용 이메일을 설정하세요.
# Analytics·광고 도입 전에 실제 수신·회신 가능한 주소인지 반드시 확인해야 합니다.
NEXT_PUBLIC_CONTACT_EMAIL=
